-- Daily London Screenings importer scheduler
-- Production project: czsknzrtumbdweusfyhk
-- Requires these Vault secrets to be configured outside source control:
--   import_scheduler_project_url
--   import_scheduler_publishable_key

create extension if not exists pg_cron;
create extension if not exists pg_net with schema extensions;

-- Idempotently replace only the daily importer jobs managed by this file.
select cron.unschedule(jobid)
from cron.job
where jobname like 'daily-import-%';

select cron.schedule(
  'daily-import-prince-charles',
  '0 1 * * *',
  $job$
  select net.http_post(
    url := (select decrypted_secret from vault.decrypted_secrets where name = 'import_scheduler_project_url')
      || '/functions/v1/import-prince-charles',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'Authorization', 'Bearer ' || (select decrypted_secret from vault.decrypted_secrets where name = 'import_scheduler_publishable_key'),
      'apikey', (select decrypted_secret from vault.decrypted_secrets where name = 'import_scheduler_publishable_key')
    ),
    body := jsonb_build_object(
      'trigger', 'daily-cron',
      'scheduled_at', now()
    ),
    timeout_milliseconds := 150000
  );
  $job$
);

